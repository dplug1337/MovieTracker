@page "/register"
@inject MovieApiClient Api
@inject NavigationManager Navigation

<PageTitle>Create account</PageTitle>

<section class="auth-wrap page-section">
    <div class="auth-card wide">
        <span class="brand-mark">M</span>
        <span class="eyebrow">START YOUR COLLECTION</span>
        <h1>Create an account</h1>
        <p>Save your watchlist and ratings in one place.</p>
        <form @onsubmit="Submit" @onsubmit:preventDefault>
            <label>Display name<input @bind="displayName" maxlength="80" required placeholder="How should we call you?" /></label>
            <label>Email address<input type="email" @bind="email" required placeholder="you@example.com" /></label>
            <div class="form-columns"><label>Password<input type="password" @bind="password" minlength="8" maxlength="128" required /></label><label>Confirm password<input type="password" @bind="confirmation" required /></label></div>
            <button class="button" type="submit" disabled="@busy">@(busy ? "Creating account…" : "Create account")</button>
        </form>
        @if (message is not null) { <div class="form-message" role="alert">@message</div> }
        <small>Already registered? <NavLink href="login">Log in</NavLink></small>
    </div>
</section>

@code {
    private string displayName = string.Empty;
    private string email = string.Empty;
    private string password = string.Empty;
    private string confirmation = string.Empty;
    private string? message;

    private bool busy;

    private async Task Submit()
    {
        if (password != confirmation)
        {
            message = "The passwords do not match.";
            return;
        }

        busy = true;
        message = null;
        try
        {
            await Api.RegisterAsync(email.Trim(), displayName.Trim(), password);
            Navigation.NavigateTo("movies");
        }
        catch (HttpRequestException ex) { message = ex.Message; }
        finally { busy = false; }
    }
}
