@page "/ratings"
@inject MovieApiClient Api

<PageTitle>Ratings</PageTitle>

<section class="page-header page-section"><span class="eyebrow">YOUR TASTE, CAPTURED</span><h1>My ratings</h1></section>

@if (!Api.IsSignedIn)
{
    <section class="state-panel page-section"><NavLink href="login">Log in to see your ratings</NavLink></section>
}
else if (error is not null)
{
    <section class="state-panel page-section" role="alert">@error</section>
}
else if (ratings is null)
{
    <section class="state-panel page-section" role="status">Loading ratings…</section>
}
else if (ratings.Length == 0)
{
    <section class="state-panel page-section">You haven’t rated any movies. <NavLink href="movies">Browse movies</NavLink></section>
}
else
{
    <section class="page-section data-panel">
        <div class="data-row data-heading"><span>Movie</span><span>Your rating</span><span>Date rated</span></div>
        @foreach (var item in ratings)
        {
            <div class="data-row">
                <strong><NavLink href="@($"movies/{item.Movie.Id}")">@item.Movie.Title</NavLink></strong>
                <span class="score">★ @item.Rating / 10</span>
                <span>@item.UpdatedAtUtc.ToString("dd MMM yyyy") UTC</span>
            </div>
        }
    </section>
}

@code {
    private PersonalRatingModel[]? ratings;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        if (!Api.IsSignedIn) return;
        try { ratings = await Api.GetRatingsAsync(); }
        catch (HttpRequestException ex) { error = ex.Message; }
    }
}
