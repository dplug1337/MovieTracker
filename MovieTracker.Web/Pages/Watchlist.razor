@page "/watchlist"
@inject MovieApiClient Api

<PageTitle>Watchlist</PageTitle>

<section class="page-header page-section"><span class="eyebrow">YOUR QUEUE</span><h1>Watchlist</h1><p>Keep every film in sight, from first interest to final credits.</p></section>

@if (!Api.IsSignedIn)
{
    <section class="state-panel page-section"><NavLink href="login">Log in to see your watchlist</NavLink></section>
}
else if (loading)
{
    <section class="state-panel page-section" role="status">Loading watchlist…</section>
}
else if (error is null && items.Length == 0)
{
    <section class="state-panel page-section">Your watchlist is empty. <NavLink href="movies">Browse movies</NavLink></section>
}
@if (error is not null)
{
    <section class="state-panel page-section" role="alert">@error</section>
}

@foreach (var group in (Api.IsSignedIn ? items : []).GroupBy(item => item.Status))
{
    <section class="page-section watchlist-group">
        <div class="section-heading"><h2>@StatusLabel(group.Key)</h2><span>@group.Count()</span></div>
        <div class="watchlist-list">
            @foreach (var item in group)
            {
                <article @key="item.Movie.Id">
                    <img src="@item.Movie.PosterUrl" alt="" />
                    <div>
                        <h3><NavLink href="@($"movies/{item.Movie.Id}")">@item.Movie.Title</NavLink></h3>
                        <p>@item.Movie.ReleaseYear · @item.Movie.Genre</p>
                    </div>
                    <div class="watchlist-actions">
                        <select aria-label="@($"Watch status for {item.Movie.Title}")" value="@StatusValue(item.Status)"
                                disabled="@busy" @onchange="e => SetStatusAsync(item.Movie.Id, e.Value?.ToString())">
                            <option value="1">Want to Watch</option>
                            <option value="2">Watching</option>
                            <option value="3">Watched</option>
                        </select>
                        <button class="quiet-button" disabled="@busy" @onclick="() => ChangeAsync(() => Api.RemoveWatchlistAsync(item.Movie.Id))">Remove</button>
                    </div>
                </article>
            }
        </div>
    </section>
}

@code {
    private WatchlistModel[] items = [];
    private string? error;
    private bool loading;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        if (!Api.IsSignedIn) return;
        loading = true;
        try { items = await Api.GetWatchlistAsync(); }
        catch (HttpRequestException ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private Task SetStatusAsync(Guid movieId, string? status) =>
        int.TryParse(status, out var value) ? ChangeAsync(() => Api.SetWatchlistAsync(movieId, value)) : Task.CompletedTask;

    private async Task ChangeAsync(Func<Task> change)
    {
        busy = true;
        error = null;
        try
        {
            await change();
            items = await Api.GetWatchlistAsync();
        }
        catch (HttpRequestException ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private static string StatusLabel(string status) => status == "WantToWatch" ? "Want to Watch" : status;
    private static int StatusValue(string status) => status switch { "Watching" => 2, "Watched" => 3, _ => 1 };
}
