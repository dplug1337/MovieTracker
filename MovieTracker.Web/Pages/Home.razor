@page "/"
@inject MovieApiClient Api

<PageTitle>Home</PageTitle>

<section class="hero page-section">
    <div>
        <span class="eyebrow">YOUR PERSONAL CINEMA JOURNAL</span>
        <h1>Remember every story<br />that moved you.</h1>
        <p>Discover movies, keep a watchlist, and turn everything you watch into a collection that is uniquely yours.</p>
        <div class="hero-actions">
            <NavLink class="button" href="movies">Browse movies</NavLink>
            <NavLink class="text-link" href="watchlist">Open my watchlist →</NavLink>
        </div>
    </div>
    @if (stats is not null)
    {
        <div class="hero-panel" aria-label="Your viewing summary">
            <span class="hero-kicker">This month (UTC)</span>
            <strong>@stats.WatchedThisMonthCount</strong>
            <span>films watched</span>
            <div class="mini-rating">Average rating <b>@(stats.AverageRating?.ToString("0.0") ?? "—")</b></div>
        </div>
    }
</section>

<section class="page-section">
    <div class="section-heading"><h2>Top-rated movies</h2><NavLink href="movies">Browse catalogue →</NavLink></div>
    @if (topError is not null)
    {
        <p role="alert">@topError</p>
    }
    else if (top is null)
    {
        <p role="status">Loading top-rated movies…</p>
    }
    else if (top.Length == 0)
    {
        <p>Movies appear here after receiving at least three ratings.</p>
    }
    else
    {
        <div class="preview-row">
            @foreach (var movie in top)
            {
                <NavLink class="preview-card" href="@($"movies/{movie.Id}")">
                    <img src="@movie.PosterUrl" alt="" />
                    <span><b>@movie.Title</b><small>@movie.ReleaseYear · ★ @movie.AverageRating.ToString("0.0") (@movie.RatingsCount)</small></span>
                </NavLink>
            }
        </div>
    }
</section>

@if (Api.IsSignedIn)
{
    <section class="page-section">
        <div class="section-heading"><h2>Continue watching</h2><NavLink href="watchlist">View watchlist →</NavLink></div>
        @if (personalError is not null)
        {
            <p role="alert">@personalError</p>
        }
        else if (watching is null)
        {
            <p role="status">Loading watchlist…</p>
        }
        else if (watching.Length == 0)
        {
            <p>Set a movie to Watching to see it here.</p>
        }
        else
        {
            <div class="preview-row">
                @foreach (var item in watching)
                {
                    <NavLink class="preview-card" href="@($"movies/{item.Movie.Id}")">
                        <img src="@item.Movie.PosterUrl" alt="" />
                        <span><b>@item.Movie.Title</b><small>@item.Movie.ReleaseYear · @item.Movie.Genre</small></span>
                    </NavLink>
                }
            </div>
        }
    </section>
}

@code {
    private TopRatedMovieModel[]? top;
    private WatchlistModel[]? watching;
    private StatisticsModel? stats;
    private string? topError;
    private string? personalError;

    protected override Task OnInitializedAsync() => Task.WhenAll(LoadTopAsync(), LoadPersonalAsync());

    private async Task LoadTopAsync()
    {
        try { top = await Api.GetTopRatedAsync(); }
        catch (HttpRequestException ex) { topError = ex.Message; }
    }

    private async Task LoadPersonalAsync()
    {
        if (!Api.IsSignedIn) return;
        try
        {
            watching = (await Api.GetWatchlistAsync()).Where(item => item.Status == "Watching").Take(3).ToArray();
            stats = await Api.GetStatisticsAsync();
        }
        catch (HttpRequestException ex) { personalError = ex.Message; }
    }
}
