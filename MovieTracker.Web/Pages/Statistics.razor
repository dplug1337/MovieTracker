@page "/statistics"
@inject MovieApiClient Api

<PageTitle>Statistics</PageTitle>

<section class="page-header page-section"><span class="eyebrow">YOUR YEAR IN FILM</span><h1>Viewing statistics</h1></section>

@if (!Api.IsSignedIn)
{
    <section class="state-panel page-section"><NavLink href="login">Log in to see your statistics</NavLink></section>
}
else if (error is not null)
{
    <section class="state-panel page-section" role="alert">@error</section>
}
else if (stats is null)
{
    <section class="state-panel page-section" role="status">Loading statistics…</section>
}
else
{
    <section class="metric-grid page-section">
        <article><span>Movies watched</span><strong>@stats.WatchedMoviesCount</strong></article>
        <article><span>Average rating</span><strong>@(stats.AverageRating?.ToString("0.0") ?? "—")</strong><small>Out of 10</small></article>
        <article><span>Favourite genre</span><strong class="metric-text">@(stats.FavouriteGenre ?? "—")</strong></article>
        <article><span>This month (UTC)</span><strong>@stats.WatchedThisMonthCount</strong></article>
    </section>
}

@code {
    private StatisticsModel? stats;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        if (!Api.IsSignedIn) return;
        try { stats = await Api.GetStatisticsAsync(); }
        catch (HttpRequestException ex) { error = ex.Message; }
    }
}
